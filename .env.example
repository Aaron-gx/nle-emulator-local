# 本地配置模板。复制为 .env 后填写自己的值。
# .env 已被 gitignore 忽略，不会进入版本库。
#
#   Copy-Item .env.example .env

# --- 本地登录账号 ---------------------------------------------------------
# 首次运行 import.mjs 时，会用这组账号创建本地管理员。
# 建议改成自己的，不要留空。
NLE_USER=
NLE_PASS=

# --- 端口 -----------------------------------------------------------------
S_PORT=8090
B_PORT=8091

# --- 服务地址 -------------------------------------------------------------
# 前端页面地址与后端接口地址，通常无需修改。
NLE_LOCAL=http://127.0.0.1:8090
NLE_BACKEND=http://127.0.0.1:8091
