# ---------------------------------------------------------------------------
# 版权软件：厂商助手安装包（32MB），不随仓库分发。
# OFFLINE.md 里有原址下载方式。
assets/*.exe
assets/*.msi

# ---------------------------------------------------------------------------
# 本地凭据：账号从 .env 读取，绝不入库
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# 数据库与运行时（WAL/SHM 同样含数据，必须一并忽略）
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
backend/data/uploads/
*.log

# ---------------------------------------------------------------------------
# N2V：密文工程不得入库；明文库属本地资产
backend/data/n2v/*.N2V
backend/data/n2v/*.n2v
backend/data/n2v/*.xml
backend/data/n2v/*.json

# 仿真工程（加密 .N2V），含题目与参考两版，按约定不随源码分发
data/assets/**/*.N2V
data/assets/**/*.n2v

# ---------------------------------------------------------------------------
# 脱敏前的原始备份：含真实个人数据，绝不入库
_backup_pre_desensitize/

# ---------------------------------------------------------------------------
# 中间产物
_mirror_raw/
**/_session.json
**/_capture*.log

# 由 tools/make-local-config.mjs 生成的报告（配置文件本身需要入库）
site/local-config/_report.json

# ---------------------------------------------------------------------------
# 大体积归档（工程所需的图标/字体等小文件不受影响）
*.zip
*.7z
*.tar
*.gz

# ---------------------------------------------------------------------------
# 浏览器自动化临时目录
.chrome-cdp/
.chrome-profile/
shots/

# ---------------------------------------------------------------------------
# Node
node_modules/
tools/package-lock.json

# ---------------------------------------------------------------------------
# 系统与编辑器
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# 一键启动器构建产物与发布包
launcher/dist/
/*.zip
/物联网仿真平台.exe
